# Copy to .env and fill in the real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=undelete_owner
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=undelete

# Password of the restricted app role undelete_app, created by
# db/init/01-app-role.sh (NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS).
APP_DB_PASSWORD=change-me-app-password

# Owner DSN (POSTGRES_USER): migrations ONLY, never used by the bot at
# runtime.
MIGRATION_DATABASE_URL=postgres://undelete_owner:change-me-superuser-password@postgres:5432/undelete?sslmode=disable

# App DSN (APP_DB_USER): bot runtime. MUST be different from
# MIGRATION_DATABASE_URL -- config.Load() refuses to start otherwise (RLS
# would become decorative if the bot ran with the owner role).
DATABASE_URL=postgres://undelete_app:change-me-app-password@postgres:5432/undelete?sslmode=disable

# --- Telegram ---
# Token obtained via @BotFather. Requires Business Mode enabled for this bot
# (see README), otherwise any Business connection attempt is refused on
# Telegram's side.
TELEGRAM_BOT_TOKEN=123456:ABC-change-me

# Onboarding allowlist (Phase 3). Comma- or space-separated Telegram user ids
# allowed to connect this bot in Business mode; each admitted holder becomes an
# isolated tenant.
#
# EMPTY = open onboarding: ANY Telegram Business account holder can connect and
# have their messages captured here. That is the real multi-tenant mode, and it
# is a deliberate choice, not a default to leave unread -- see "Onboarding
# modes" in docs/runbook.md before deploying it.
#
# A deployment that used to run mono-tenant keeps exactly the guarantee it had
# by listing its single holder here.
#
# OWNER_TELEGRAM_USER_ID (the Phase 1 mono-tenant guard) no longer exists: the
# bot REFUSES TO START if it is still set to a value, rather than silently
# switching that deployment to open onboarding.
OWNER_ALLOWLIST_TELEGRAM_USER_IDS=

# --- Per-tenant quotas (issue #19) ---
# Bounds what ONE tenant can consume of the shared instance: stored messages,
# catalogued media files, stored media bytes and capture rate per sliding
# minute. Keyed by the internal owner id the connection resolved to -- never
# by anything read from the update, so no identifier can be spoofed into
# another tenant's budget.
#
# A tenant past a quota has its further captures DROPPED explicitly (logged
# with ids only, quota metrics): deletions already stored are still alerted,
# and /delete_my_data still works -- an erasure must work precisely when the
# tenant is over quota. Usage at QUOTA_WARN_PERCENT of a limit emits the
# pre-saturation alert once per crossing.
#
# Absent = the generous default below. Malformed or non-positive = the bot
# refuses to start rather than running an unbounded tenant silently. Pure
# configuration: rollback is redeploying the previous image, no migration.
# QUOTA_MAX_MESSAGES_PER_TENANT=100000
# QUOTA_MAX_MEDIA_FILES_PER_TENANT=10000
# QUOTA_MAX_MEDIA_BYTES_PER_TENANT=5368709120
# QUOTA_CAPTURES_PER_MINUTE_PER_TENANT=300
# QUOTA_WARN_PERCENT=80

# --- Supervision ---
# Listen address of the /livez, /readyz and /metrics probes. Leave commented
# for the default ":9090" (internal port on the Docker network, not
# published). Setting it empty completely disables the health server -- the
# Compose healthcheck of the bot service would then fail, as it queries
# /livez.
# HEALTH_ADDR=:9090

# --- Media retention ---
# Dry run of the media purge: it logs every file it WOULD delete from ./media
# and writes nothing, neither on disk nor in the catalogue. Meant for the first
# runs against a real storage tree -- a wrongly deleted blob is gone, whereas
# keeping it one more day costs nothing. Leave it unset (or "false") in normal
# operation: a retention that never runs is a silent breach of the promise made
# to the owner. Only a real boolean is accepted ("true"/"false"/"1"/"0"); a
# typo fails at startup rather than silently disabling the purge.
# MEDIA_PURGE_DRY_RUN=false

# --- Backups ---
# Purge horizon of the daily dumps (scripts/backup.sh). Read by the bot too,
# and only for one sentence: the /delete_my_data confirmation states it as the
# maximum residual survival of the erased data in archives already written. An
# absent value means 14 days on both sides; a non-numeric or non-positive one
# fails the bot at startup rather than letting it quote a number that matches
# nothing.
BACKUP_RETENTION_DAYS=14

# Media archives (scripts/backup-media.sh). "auto" takes a full when the last
# one is older than MEDIA_BACKUP_FULL_INTERVAL_DAYS, an incremental otherwise;
# "full" and "incremental" force one mode.
# NOTE: media archives are NEVER purged automatically -- an incremental chain
# is only restorable while its base full exists. Retention is manual, see
# docs/backup-restore.md.
# MEDIA_BACKUP_MODE=auto
# MEDIA_BACKUP_FULL_INTERVAL_DAYS=7

# Dead man's switch for the daily backup loop (optional but recommended, e.g.
# a healthchecks.io check): pinged after every fully successful pass (dump AND
# media). A missed ping means the backups are NOT happening. Every failure
# also prints a greppable "backup: FATAL" line in `docker compose logs backup`.
# Leave unset to disable the ping.
# BACKUP_PING_URL=https://hc-ping.com/your-uuid-here
