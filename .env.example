# Copier en .env et renseigner les valeurs réelles. Ne jamais committer .env.

# --- Postgres ---
POSTGRES_USER=undelete_owner
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=undelete

# Mot de passe du rôle applicatif restreint undelete_app, créé par
# db/init/01-app-role.sh (NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS).
APP_DB_PASSWORD=change-me-app-password

# DSN propriétaire (POSTGRES_USER) : migrations UNIQUEMENT, jamais utilisé
# par le bot en runtime.
MIGRATION_DATABASE_URL=postgres://undelete_owner:change-me-superuser-password@postgres:5432/undelete?sslmode=disable

# DSN applicatif (APP_DB_USER) : runtime du bot. DOIT être différent de
# MIGRATION_DATABASE_URL -- config.Load() refuse de démarrer sinon (RLS
# deviendrait décoratif si le bot tournait avec le rôle propriétaire).
DATABASE_URL=postgres://undelete_app:change-me-app-password@postgres:5432/undelete?sslmode=disable

# --- Telegram ---
# Jeton obtenu via @BotFather. Nécessite Business Mode activé pour ce bot
# (voir README) sans quoi toute tentative de connexion Business est refusée
# côté Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-change-me

# Garde-fou mono-tenant Phase 1 : si défini, seule une connexion Business
# provenant de ce telegram_user_id est acceptée. Laisser vide en dev
# uniquement.
OWNER_TELEGRAM_USER_ID=

# --- Backups ---
BACKUP_RETENTION_DAYS=14
