# Copy to .env and fill in the real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=undelete_owner
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=undelete

# Password of the restricted app role undelete_app, created by
# db/init/01-app-role.sh (NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS).
APP_DB_PASSWORD=change-me-app-password

# Owner DSN (POSTGRES_USER): migrations ONLY, never used by the bot at
# runtime.
MIGRATION_DATABASE_URL=postgres://undelete_owner:change-me-superuser-password@postgres:5432/undelete?sslmode=disable

# App DSN (APP_DB_USER): bot runtime. MUST be different from
# MIGRATION_DATABASE_URL -- config.Load() refuses to start otherwise (RLS
# would become decorative if the bot ran with the owner role).
DATABASE_URL=postgres://undelete_app:change-me-app-password@postgres:5432/undelete?sslmode=disable

# --- Telegram ---
# Token obtained via @BotFather. Requires Business Mode enabled for this bot
# (see README), otherwise any Business connection attempt is refused on
# Telegram's side.
TELEGRAM_BOT_TOKEN=123456:ABC-change-me

# Phase 1 mono-tenant guardrail: if set, only a Business connection from this
# telegram_user_id is accepted. Leave empty in dev only.
OWNER_TELEGRAM_USER_ID=

# --- Supervision ---
# Listen address of the /livez, /readyz and /metrics probes. Leave commented
# for the default ":9090" (internal port on the Docker network, not
# published). Setting it empty completely disables the health server -- the
# Compose healthcheck of the bot service would then fail, as it queries
# /livez.
# HEALTH_ADDR=:9090

# --- Media retention ---
# Dry run of the media purge: it logs every file it WOULD delete from ./media
# and writes nothing, neither on disk nor in the catalogue. Meant for the first
# runs against a real storage tree -- a wrongly deleted blob is gone, whereas
# keeping it one more day costs nothing. Leave it unset (or "false") in normal
# operation: a retention that never runs is a silent breach of the promise made
# to the owner. Only a real boolean is accepted ("true"/"false"/"1"/"0"); a
# typo fails at startup rather than silently disabling the purge.
# MEDIA_PURGE_DRY_RUN=false

# --- Backups ---
BACKUP_RETENTION_DAYS=14
